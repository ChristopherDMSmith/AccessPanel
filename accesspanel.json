    "releasenotes": {
      "1.0.0": {
        "0": "Initial release after Hermes prototype"
      },
      "1.0.1": {
        "0": "Updated manifest version to 1.0.1",
        "1": "Updated background session handling to better control the side panel and prevent unexpected closures"
      },
      "2.0.0": {
        "0": "Hardened sensitive credential and token storage using session-scoped browser storage",
        "1": "Added migration cleanup for sensitive data retained by previous releases",
        "2": "Added an explicit Content Security Policy and restricted WFM communication to HTTPS",
        "3": "Removed legacy clipboard fallbacks that triggered antivirus heuristic detections",
        "4": "Removed webpage DOM scraping, script injection, and the scripting browser permission",
        "5": "Replaced document.write and innerHTML usage with DOM-safe rendering",
        "6": "Removed saved My APIs and persistent custom request definitions",
        "7": "Removed Postman, Bruno, and environment export functionality",
        "8": "Removed Pull From TMS and automatic Incognito token scraping",
        "9": "Added manual session Access Token support, including API Library use in Incognito mode",
        "10": "Simplified and corrected collapsible UI behavior",
        "11": "Reduced browser and host permissions to required functionality only",
        "12": "Corrected the Developer Portal link for Timekeeping - Retrieve Punches"
      }
